#!/usr/bin/env bash
set -euo pipefail

JOB_ID="__JOB_ID__"
S3_PROJECT_URI="__S3_PROJECT_URI__"
S3_RESULTS_URI="__S3_RESULTS_URI__"
REMOTE_COMMAND_B64="__REMOTE_COMMAND_B64__"
REMOTE_COMMAND="$(printf '%s' \"${REMOTE_COMMAND_B64}\" | base64 --decode)"
ENABLE_GDRIVE_SYNC="__ENABLE_GDRIVE_SYNC__"
GDRIVE_REMOTE="__GDRIVE_REMOTE__"
GDRIVE_DEST="__GDRIVE_DEST__"

WORKDIR="/opt/brane-job"
RESULTS_DIR="${WORKDIR}/results"
LOG_DIR="${WORKDIR}/logs"
mkdir -p "${RESULTS_DIR}" "${LOG_DIR}"

exec > >(tee "${LOG_DIR}/user-data.log") 2>&1

sync_results() {
  echo "[sync] Uploading results to ${S3_RESULTS_URI}"
  aws s3 sync "${RESULTS_DIR}" "${S3_RESULTS_URI}" --delete || true
  aws s3 cp "${LOG_DIR}/user-data.log" "${S3_RESULTS_URI}/user-data.log" || true

  if [[ "${ENABLE_GDRIVE_SYNC}" == "true" ]]; then
    if command -v rclone >/dev/null 2>&1; then
      echo "[sync] Uploading results to Google Drive: ${GDRIVE_REMOTE}:${GDRIVE_DEST}/${JOB_ID}"
      rclone copy "${RESULTS_DIR}" "${GDRIVE_REMOTE}:${GDRIVE_DEST}/${JOB_ID}" --progress || true
    else
      echo "[sync] Skipping Google Drive sync (rclone not installed)"
    fi
  fi
}

cleanup_and_exit() {
  local code=$1
  echo "[cleanup] Exit code: ${code}"
  sync_results
  echo "[cleanup] Requesting shutdown"
  sudo shutdown -h now || true
  exit "${code}"
}

trap 'cleanup_and_exit $?' EXIT

export DEBIAN_FRONTEND=noninteractive
sudo apt-get update
sudo apt-get install -y python3-pip python3-venv ffmpeg awscli rclone git

python3 -m venv "${WORKDIR}/venv"
source "${WORKDIR}/venv/bin/activate"

cd "${WORKDIR}"

aws s3 cp "${S3_PROJECT_URI}" "${WORKDIR}/project.tar.gz"
tar -xzf "${WORKDIR}/project.tar.gz" -C "${WORKDIR}"

# If the archive expands to a single top-level folder, use it. Otherwise use WORKDIR.
PROJECT_DIR="${WORKDIR}"
TOP_LEVEL_DIR_COUNT=$(find "${WORKDIR}" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')
if [[ "${TOP_LEVEL_DIR_COUNT}" == "1" ]]; then
  PROJECT_DIR=$(find "${WORKDIR}" -mindepth 1 -maxdepth 1 -type d | head -n 1)
fi

cd "${PROJECT_DIR}"
pip install --upgrade pip
pip install -r requirements.txt
pip install scipy
pip install -e .

export BRANESIM_RESULTS_DIR="${RESULTS_DIR}"

echo "[run] Executing remote command"
bash -lc "${REMOTE_COMMAND}"

# Final sync happens in EXIT trap.
